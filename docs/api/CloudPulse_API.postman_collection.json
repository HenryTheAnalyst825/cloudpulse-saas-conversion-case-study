    {
      "name": "5. POST stripe-events (200, invoice.paid)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Stripe signs \"<timestamp>.<raw body>\" with the webhook secret (HMAC-SHA256).\nconst body = pm.variables.replaceIn(pm.request.body.raw);   // resolve {{org_id}} before signing\nconst ts = Math.floor(Date.now() / 1000);\nconst sig = CryptoJS.HmacSHA256(`${ts}.${body}`, pm.variables.get(\"stripe_webhook_secret\")).toString();\npm.request.headers.upsert({ key: \"Stripe-Signature\", value: `t=${ts},v1=${sig}` });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));\nconst maxMs = Number(pm.variables.get(\"max_response_ms\") || 300);\npm.test(`Response time < ${maxMs}ms`, () => pm.expect(pm.response.responseTime).to.be.below(maxMs));\nconst schema = {\n  type: \"object\",\n  required: [\"received\",\"event_id\",\"processed_action\",\"org_status\"],\n  properties: {\n    received: { const: true },\n    event_id: { type: \"string\", pattern: \"^evt_\" },\n    processed_action: { enum: [\"Payment_Succeeded\",\"Payment_Failed\"] },\n    org_status: { enum: [\"Active\",\"Past_Due\"] }\n  }\n};\npm.test(\"Schema is valid\", () => pm.response.to.have.jsonSchema(schema));\npm.test(\"invoice.paid maps to Active\", () => {\n  const d = pm.response.json();\n  pm.expect(d.processed_action).to.eql(\"Payment_Succeeded\");\n  pm.expect(d.org_status).to.eql(\"Active\");\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Stripe-Signature",
            "value": "set-by-pre-request-script"
          },
