      "name": "1. GET usage-summary (200, Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));\nconst maxMs = Number(pm.variables.get(\"max_response_ms\") || 300);\npm.test(`Response time < ${maxMs}ms`, () => pm.expect(pm.response.responseTime).to.be.below(maxMs));\npm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));\nconst schema = {\n  type: \"object\",\n  required: [\"org_id\",\"plan_tier\",\"status\",\"quota_limit\",\"quota_used\",\"quota_remaining\",\"usage_percent\",\"threshold_state\",\"billing_cycle_reset_date\"],\n  properties: {\n    org_id: { type: \"string\" },\n    plan_tier: { enum: [\"Free\",\"Pro\",\"Enterprise\"] },\n    status: { enum: [\"Active\",\"Suspended\",\"Past_Due\"] },\n    quota_limit: { type: \"integer\", minimum: 0 },\n    quota_used: { type: \"integer\", minimum: 0 },\n    quota_remaining: { type: \"integer\", minimum: 0 },\n    usage_percent: { type: \"number\", minimum: 0 },\n    threshold_state: { enum: [\"NORMAL\",\"WARNING_80\",\"BLOCKED_100\"] },\n    billing_cycle_reset_date: { type: \"string\" }\n  }\n};\npm.test(\"Schema is valid\", () => pm.response.to.have.jsonSchema(schema));\npm.test(\"Quota math and threshold are consistent\", () => {\n  const d = pm.response.json();\n  pm.expect(d.quota_remaining).to.eql(Math.max(d.quota_limit - d.quota_used, 0));\n  const expected = d.usage_percent >= 100 ? \"BLOCKED_100\" : d.usage_percent >= 80 ? \"WARNING_80\" : \"NORMAL\";\n  pm.expect(d.threshold_state).to.eql(expected);\n});"
            ]
          }
        }
      ],
